{
  "kind": "collectionType",
  "collectionName": "recipes",
  "info": {
    "singularName": "recipe",
    "pluralName": "recipes",
    "displayName": "Recipe"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "text"
    },
    "instructions": {
      "type": "blocks"
    },
    "cooking_time_minutes": {
      "type": "integer"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "recipe_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::recipe-category.recipe-category",
      "inversedBy": "recipes"
    },
    "ingredients": {
      "type": "component",
      "component": "recipe.recipe-ingredient",
      "repeatable": true
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "recipes"
    }
  }
}
